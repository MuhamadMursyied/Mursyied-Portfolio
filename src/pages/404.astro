---
import Base from "../layouts/Base.astro";
import { url } from "../utils";
---

<Base title="Page not found">
  <section class="container lost">
    <p class="mono code">ERROR 404 · SIGNAL LOST</p>
    <h1 class="gradient-text">This route isn't on the map.</h1>
    <a class="btn primary" href={url("")}>Back to base</a>
  </section>
</Base>

<style>
  .lost { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 22px; padding-top: 80px; }
  .code { color: var(--accent); letter-spacing: 0.2em; font-size: 0.85rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 4rem); }
</style>
