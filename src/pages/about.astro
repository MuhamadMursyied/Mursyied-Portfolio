---
// About me, told as a trip down one road: scroll and the 3D camera flies from stop to stop
// of my career (src/scripts/journey3d.ts). The cards hold the facts, so the page still reads without 3D.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { journey } from "../data/journey";
import { currently, intro, person, socials } from "../data/profile";
import { bold, url } from "../utils";

const titles = new Map((await getCollection("projects", (p) => !p.data.draft)).map((p) => [p.id, p.data.title]));
---

<Base title={`About · ${person.name}`} description={`About ${person.name}, ${person.role}: experience and studies, told as a 3D journey from a Kedah classroom to robots that drive themselves.`} footer={false} hud>
  <section class="journey" data-journey>
    <div class="j-stage" data-j-stage>
      <p class="j-loading mono">Loading the journey…</p>
      <div class="j-me" data-j-me aria-hidden="true">
        <span class="in"><img src={url(person.avatar)} alt="" width="40" height="40" /></span>
      </div>
    </div>
    <div class="j-scrim" aria-hidden="true"></div>

    <nav class="j-rail" aria-label="Journey stops">
      <button type="button" class="j-dot" data-j-dot aria-label="About me"><span class="mono">Me</span></button>
      {journey.map((s) => (
        <button type="button" class="j-dot" data-j-dot aria-label={`${s.years}: ${s.title}`}><span class="mono">{s.years.split(" – ")[0]}</span></button>
      ))}
      <button type="button" class="j-dot" data-j-dot aria-label="Contact"><span class="mono">Contact</span></button>
    </nav>

    <p class="j-live glass mono" aria-live="polite">
      <span class="live"></span><span data-hud-place>Rawang, Selangor</span>
      <span class="sep">·</span><span data-w="temp">--°C</span>
      <span class="sep">·</span><span data-w="cond">Live sky</span>
    </p>

    <div class="j-flow">
      <header class="j-sec j-intro" data-j-sec id="intro">
        <div class="j-card glass">
          <div class="who">
            <img class="avatar" src={url(person.avatar)} alt={person.name} width="84" height="84" />
            <div>
              <p class="kicker mono">About me <span>/ {person.role}</span></p>
              <h1>Hi, I'm {person.firstName}.</h1>
              <p class="place mono"><Icon name="globe" size={13} /> {person.location}</p>
            </div>
          </div>
          {intro.map((p) => <p class="lead" set:html={bold(p)} />)}
          <ul class="langs">{person.languages.map((l) => <li class="chip">{l}</li>)}</ul>
          <div class="links">
            {socials.map((so) => (
              <a class="btn" href={so.url} target={so.url.startsWith("http") ? "_blank" : undefined} rel="noopener"><Icon name={so.icon} size={16} />{so.label}</a>
            ))}
          </div>
          <p class="hint mono"><Icon name="arrow" size={14} /> Scroll through my journey</p>
        </div>
      </header>

      {journey.map((s, i) => (
        <section class="j-sec" data-j-sec id={s.id} aria-labelledby={`${s.id}-t`}>
          {s.id === "umpsa" && <span id="studies" class="anchor" />}
          {s.id === "mimos" && <span id="experience" class="anchor" />}
          <article class="j-card glass">
            <p class="step mono"><span class="n">{String(i + 1).padStart(2, "0")}</span> {s.years}</p>
            <h2 id={`${s.id}-t`}><Icon name={s.icon} size={22} /> {s.title}</h2>
            <p class="org">{s.org}</p>
            <p class="place mono">{s.place}</p>
            <p class="summary">{s.summary}</p>
            <ul class="did">{s.did.map((d) => <li>{d}</li>)}</ul>
            {s.projects.length > 0 && (
              <div class="projects">
                {s.projects.filter((p) => titles.has(p)).map((p) => (
                  <a class="chip" href={url(`work/${p}/`)}>{titles.get(p)} <Icon name="arrow" size={13} /></a>
                ))}
              </div>
            )}
            {s.id === "mimos" && (
              <div class="now">
                <p class="step mono"><span class="n">●</span> Currently working on</p>
                <ul>{currently.map((c) => <li>{c}</li>)}</ul>
              </div>
            )}
          </article>
        </section>
      ))}

      <section class="j-sec" data-j-sec id="contact" aria-labelledby="contact-t">
        <article class="j-card glass contact">
          <p class="kicker mono">Contact</p>
          <h2 id="contact-t">Let's build something that moves.</h2>
          <p class="summary">Interested in robotics, automation, autonomous systems or a collaboration? I'm happy to talk.</p>
          <div class="actions">
            <a class="btn primary" href={`mailto:${person.email}`}><Icon name="mail" size={17} /> {person.email}</a>
          </div>
          <div class="actions">
            <a class="btn" href={url("work/")}>All my work <Icon name="arrow" size={16} /></a>
            <a class="btn" href={url("skills/")}>Skills</a>
            <a class="btn" href={url("work/#training")}>Training</a>
          </div>
        </article>
      </section>
    </div>
  </section>
</Base>

<style>
  .journey { position: relative; }
  .j-stage { position: fixed; inset: 0; z-index: 0; background: linear-gradient(180deg, #9fb9c9, #dfe6da); }
  :global([data-theme="dark"]) .j-stage { background: linear-gradient(180deg, #0b1322, #1b2230); }
  .j-stage :global(.w3-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .j-loading { position: absolute; left: 60%; top: 50%; transform: translate(-50%, -50%); margin: 0; font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  :global(.j3-ready) .j-loading, :global(.j3-off) .j-loading { display: none; }
  :global(.j3-off) .j-stage { background: radial-gradient(ellipse 70% 60% at 65% 50%, rgb(var(--cyan-rgb) / 0.12), transparent 70%), var(--bg); }
  .j-scrim { position: fixed; inset: 0 auto 0 0; width: 56%; z-index: 1; pointer-events: none; background: linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 80%, transparent) 30%, transparent 100%); opacity: 0.9; }

  .j-me { position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none; transition: opacity 0.4s; }
  .j-me .in { display: block; transform: translate(-50%, -100%); }
  .j-me img { display: block; width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--cyan); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35); object-fit: cover; }

  .j-flow { position: relative; z-index: 2; }
  .j-sec { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; padding: 90px clamp(16px, 4vw, 64px); }
  .j-card { width: min(470px, 100%); padding: 26px 28px; border-radius: 22px; transition: opacity 0.5s, transform 0.5s; }
  :global(.j3-ready) .j-sec:not(.on) .j-card { opacity: 0.35; transform: translateY(14px); }
  .kicker { margin: 0 0 12px; font-size: 0.74rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .kicker span { color: var(--faint); }
  .j-intro h1 { font-size: clamp(2rem, 3.6vw, 2.8rem); line-height: 1.02; letter-spacing: -0.03em; margin: 0 0 6px; }
  .who { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .avatar { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 3px rgb(var(--cyan-rgb) / 0.4), 0 0 30px rgb(var(--cyan-rgb) / 0.3); }
  .who .place { display: inline-flex; align-items: center; gap: 6px; margin: 0; }
  .lead { color: var(--muted); margin: 0 0 12px; line-height: 1.6; font-size: 0.95rem; }
  .lead :global(strong) { color: var(--text); }
  .langs { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0 0 10px; }
  .langs .chip { font-size: 0.72rem; padding: 4px 9px; }
  .links { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .links .btn { min-height: 38px; padding: 0 13px; font-size: 0.85rem; }
  .now { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--glass-border); }
  .now ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
  .now .n { color: var(--accent); animation: j-blink 1.6s ease-in-out infinite; }
  .contact h2 { display: block; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .anchor { position: absolute; top: 0; }
  .j-sec { position: relative; }
  @keyframes j-blink { 50% { opacity: 0.3; } }
  .hint { display: inline-flex; align-items: center; gap: 8px; margin: 0; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .hint :global(svg) { transform: rotate(90deg); animation: j-bob 1.6s ease-in-out infinite; }
  .step { margin: 0 0 8px; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .step .n { color: var(--accent); margin-right: 6px; }
  h2 { display: flex; align-items: center; gap: 10px; font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.15; margin: 0 0 10px; }
  h2 :global(svg) { color: var(--accent); flex: none; }
  .org { margin: 0; font-weight: 600; }
  .place { margin: 4px 0 14px; font-size: 0.74rem; color: var(--faint); letter-spacing: 0.04em; }
  .summary { margin: 0 0 12px; color: var(--muted); line-height: 1.6; }
  .did { margin: 0 0 16px; padding-left: 18px; color: var(--text); line-height: 1.55; font-size: 0.94rem; }
  .did li + li { margin-top: 5px; }
  .did li::marker { color: var(--accent); }
  .projects { display: flex; flex-wrap: wrap; gap: 6px; }
  .projects .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; text-decoration: none; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }

  .j-rail { position: fixed; right: clamp(12px, 2vw, 28px); top: 50%; transform: translateY(-50%); z-index: 3; display: flex; flex-direction: column; gap: 4px; padding: 8px; border-radius: 18px; }
  .j-rail::before { content: ""; position: absolute; left: 50%; top: 22px; bottom: 22px; width: 1px; background: var(--glass-border); }
  .j-dot { position: relative; display: flex; align-items: center; justify-content: flex-end; gap: 8px; height: 30px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--muted); }
  .j-dot::after { content: ""; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--glass-border); background: var(--bg); transition: transform 0.25s, background 0.25s, border-color 0.25s; }
  .j-dot span { font-size: 0.66rem; letter-spacing: 0.08em; opacity: 0; transform: translateX(6px); transition: opacity 0.25s, transform 0.25s; white-space: nowrap; }
  .j-dot:hover span, .j-dot.on span { opacity: 1; transform: none; }
  .j-dot.on { color: var(--text); }
  .j-dot.on::after { background: var(--accent); border-color: var(--accent); transform: scale(1.25); box-shadow: 0 0 12px var(--accent); }

  .j-live { position: fixed; right: clamp(12px, 2vw, 28px); bottom: 18px; z-index: 3; display: inline-flex; align-items: center; gap: 7px; margin: 0; padding: 8px 14px; border-radius: 999px; font-size: 0.68rem; letter-spacing: 0.06em; color: var(--muted); }
  .j-live .sep { color: var(--faint); }
  .j-live .live { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }

  @keyframes j-bob { 50% { transform: rotate(90deg) translateX(4px); } }

  @media (max-width: 900px) {
    .j-scrim { inset: auto 0 0 0; width: 100%; height: 60%; background: linear-gradient(0deg, var(--bg) 10%, transparent); }
    .j-sec { align-items: flex-end; padding: 80px 12px 110px; }
    .j-card { padding: 18px 18px; }
    .j-rail { top: 76px; transform: none; padding: 4px; }
    .j-dot span { display: none; }
    .j-live { bottom: auto; top: 14px; right: 12px; }
    .did { font-size: 0.86rem; margin-bottom: 10px; }
    .summary { font-size: 0.9rem; margin-bottom: 10px; }
    .lead { font-size: 0.88rem; }
    .projects { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
    .projects .chip { flex: none; }
    .j-rail { top: 64px; }
    .j-live { left: 12px; right: auto; max-width: calc(100% - 24px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .j-card, .hint :global(svg) { transition: none; animation: none; }
  }
</style>
