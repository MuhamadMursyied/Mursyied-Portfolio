---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { FIELD, HOME, POND, TABLET, TERRAIN, box, iso, polygon, route, waypoints } from "../data/mission";
import { url } from "../utils";

const xy = (x: number, y: number, z = 0) => iso(x, y, z).map((n) => n.toFixed(1)).join(",");
const T = TERRAIN;
const F = FIELD;

// Ground slab, drawn as a floating diorama.
const slab =
  polygon([[T.x1, T.y0, 0], [T.x1, T.y1, 0], [T.x1, T.y1, -34], [T.x1, T.y0, -34]], "slab-r") +
  polygon([[T.x0, T.y1, 0], [T.x1, T.y1, 0], [T.x1, T.y1, -34], [T.x0, T.y1, -34]], "slab-l") +
  polygon([[T.x0, T.y0], [T.x1, T.y0], [T.x1, T.y1], [T.x0, T.y1]], "slab-t");
const field = polygon([[F.x0, F.y0], [F.x1, F.y0], [F.x1, F.y1], [F.x0, F.y1]], "field");
const rows = [1, 3, 5, 7, 9, 11, 13].map((y) => `<line class="crop" x1="${iso(F.x0 + 0.6, y)[0]}" y1="${iso(F.x0 + 0.6, y)[1]}" x2="${iso(y > 9 ? 19.6 : F.x1 - 0.6, y)[0]}" y2="${iso(y > 9 ? 19.6 : F.x1 - 0.6, y)[1]}"/>`).join("");
const [pondX, pondY] = iso(POND.x, POND.y);
const plan = route.map((p) => xy(p.x, p.y)).join(" ");

// Field station behind the home point.
const station =
  box(-3.6, 2.2, 0, 1.9, 1.6, 0, 62, "bd") +
  polygon([[-1.7, 1.5, 0], [-1.7, 2.9, 0], [-1.7, 2.9, 36], [-1.7, 1.5, 36]], "bd-door") +
  polygon([[-5.4, 3.8, 42], [-2.2, 3.8, 42], [-2.2, 3.8, 50], [-5.4, 3.8, 50]], "bd-win");

const tree = ([x, y]: number[]) => {
  const [bx, by] = iso(x, y);
  return `<g class="tree"><ellipse class="tree-shadow" cx="${bx}" cy="${by}" rx="18" ry="9"/><line class="trunk" x1="${bx}" y1="${by}" x2="${bx}" y2="${by - 26}"/><circle class="leaf" cx="${bx}" cy="${by - 40}" r="19"/><circle class="leaf-hi" cx="${bx - 6}" cy="${by - 46}" r="9"/></g>`;
};
const byDepth = (a: number[], b: number[]) => a[0] + a[1] - (b[0] + b[1]);
const backTrees: number[][] = [];
for (let x = -1; x <= 25; x += 3) backTrees.push([x, -2.6]);
for (let y = 6.5; y <= 16; y += 3) backTrees.push([-5.6, y]);
const frontTrees: number[][] = [];
for (let y = -1.5; y <= 16; y += 3) frontTrees.push([25, y]);
for (let x = -4; x <= 22; x += 3.5) frontTrees.push([x, 16.8]);
backTrees.sort(byDepth);
frontTrees.sort(byDepth);

const kiosk =
  box(TABLET.x, TABLET.y, 0, 0.1, 0.1, 0, 30, "kp") +
  box(TABLET.x, TABLET.y, 0.5, 0.48, 0.32, 30, 34, "kt");
const [opX, opY] = iso(TABLET.x - 0.2, TABLET.y + 1.1);
const [homeX, homeY] = iso(HOME.x, HOME.y);
const [kioskX, kioskY] = iso(TABLET.x, TABLET.y, 34);

const tag = (text: string, cls = "") => {
  const w = text.length * 7.6 + 22;
  return `<g class="tag ${cls}"><rect x="${-w / 2}" y="-15" width="${w}" height="26" rx="13"/><text y="3">${text}</text></g>`;
};

const steps = [
  { icon: "send", label: "Command sent" },
  { icon: "route", label: "Route loaded" },
  { icon: "ugv", label: "Navigating" },
  { icon: "flag", label: "Coverage done" },
  { icon: "home", label: "Returned home" },
];
const nodes = [
  { name: "/mission_manager", note: "mission" },
  { name: "/bt_navigator", note: "Nav2" },
  { name: "/planner_server", note: "Nav2" },
  { name: "/controller_server", note: "Nav2", drive: true },
  { name: "/ekf_node", note: "localization" },
  { name: "/gnss_driver", note: "sensor" },
];
const topics = [
  { name: "/gnss/fix", hz: 10, always: true },
  { name: "/imu/data", hz: 100, always: true },
  { name: "/odom", hz: 50, always: true },
  { name: "/odometry/filtered", hz: 30, always: true },
  { name: "/cmd_vel", hz: 20 },
  { name: "/mission/status", hz: 1, always: true },
];
const flow = [
  { icon: "tablet", title: "Tablet app", tech: "React", text: "The operator picks the mission and starts it with one tap." },
  { icon: "send", title: "API server", tech: "Python · FastAPI", text: "Takes the command from the tablet and hands it to the robot software." },
  { icon: "route", title: "Mission software", tech: "Python · ROS 2", text: "Loads the 58-point coverage route and turns it into navigation goals." },
  { icon: "fusion", title: "Nav2 + EKF", tech: "ROS 2", text: "Plans and follows the path while the EKF fuses GNSS, IMU and wheel odometry." },
  { icon: "ugv", title: "Hunter SE", tech: "NVIDIA Jetson", text: "Drives every lane, reports progress back to the tablet and returns home." },
];
---

<Base title="Mission control · Muhamad Mursyied" image="images/mission-preview.jpg" description="An interactive replay of how I run an autonomous 58-point field coverage mission with ROS 2, Nav2 and a tablet control app.">
  <section class="container page-head">
    <span class="label reveal">Mission control</span>
    <h1 class="reveal gradient-text">How I run a field mission</h1>
    <p class="lead reveal">
      An animated replay of how I work at MIMOS: one command from a tablet sends the Hunter SE robot through a 58-point
      coverage route and back home. Click the robot, a waypoint or the tablet to inspect it, drag to move the map.
    </p>
  </section>

  <section class="container">
    <div class="mc glass reveal" data-mission data-phase="command">
      <!-- icons the script copies into the inspector -->
      <div hidden>
        {["ugv", "pin", "tablet", "home"].map((name) => <span data-icon={name}><Icon name={name} size={20} /></span>)}
      </div>

      <header class="mc-top">
        <div class="mc-brand">
          <span class="mc-logo"><Icon name="radar" size={18} /></span>
          <div><strong>Mission control</strong><small class="mono">Hunter SE · coverage mission</small></div>
        </div>
        <p class="mc-status"><span class="mc-live"></span><span class="mc-phase">Command received</span></p>
        <div class="mc-controls">
          <button type="button" class="mc-btn" data-play aria-pressed="true" aria-label="Pause replay">
            <span class="i-pause"><Icon name="pause" size={16} /></span><span class="i-play"><Icon name="play" size={16} /></span>
          </button>
          <button type="button" class="mc-btn" data-restart aria-label="Restart mission"><Icon name="restart" size={16} /></button>
          <div class="mc-rate" role="group" aria-label="Replay speed">
            {[1, 2, 4].map((r) => <button type="button" data-rate={r} aria-pressed={r === 1 ? "true" : "false"}>{r}×</button>)}
          </div>
          <span class="mc-sim mono">SIMULATED</span>
        </div>
      </header>

      <div class="mc-scene">
        <svg class="mc-map" viewBox="-710 -190 1600 900" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Isometric map of the field, the robot and its 58 waypoints">
          <defs>
            <radialGradient id="mc-glow"><stop offset="0" stop-color="var(--cyan)" stop-opacity="0.45" /><stop offset="1" stop-color="var(--cyan)" stop-opacity="0" /></radialGradient>
          </defs>
          <g set:html={slab} />
          <g set:html={field} />
          <g set:html={rows} />
          <ellipse class="pond" cx={pondX} cy={pondY} rx={POND.r * 45} ry={POND.r * 22.5} />
          <polygon class="fence" points={[[F.x0, F.y0], [F.x1, F.y0], [F.x1, F.y1], [F.x0, F.y1]].map(([x, y]) => xy(x, y)).join(" ")} />
          <polyline class="mc-plan" points={plan} />
          <polyline class="mc-trail" points="" />

          <g data-obj="home" class="obj">
            <g set:html={polygon([[HOME.x - 1.3, HOME.y - 1.3], [HOME.x + 1.3, HOME.y - 1.3], [HOME.x + 1.3, HOME.y + 1.3], [HOME.x - 1.3, HOME.y + 1.3]], "pad")} />
            <g set:html={polygon([[HOME.x - 0.8, HOME.y - 0.8], [HOME.x + 0.8, HOME.y - 0.8], [HOME.x + 0.8, HOME.y + 0.8], [HOME.x - 0.8, HOME.y + 0.8]], "pad-in")} />
            <circle class="hit" cx={homeX} cy={homeY} r="40" />
          </g>

          {waypoints.map((wp) => {
            const [x, y] = iso(wp.x, wp.y);
            return (
              <g class="wp" data-wp={wp.id} transform={`translate(${x} ${y})`}>
                <title>Waypoint {wp.id}</title>
                <ellipse class="wp-ring" rx="15" ry="7.5" />
                <ellipse class="wp-dot" rx="7" ry="3.5" />
                <circle class="hit" r="15" />
              </g>
            );
          })}

          <g set:html={backTrees.map(tree).join("")} />
          <g set:html={station} />

          <g data-obj="tablet" class="obj">
            <g set:html={kiosk} />
            <g class="operator" transform={`translate(${opX} ${opY})`}>
              <ellipse class="tree-shadow" rx="12" ry="6" />
              <rect x="-7" y="-40" width="14" height="32" rx="7" />
              <circle cy="-48" r="7.5" />
            </g>
            <circle class="hit" cx={kioskX} cy={kioskY + 10} r="38" />
          </g>

          <line class="mc-beam" x1={kioskX} y1={kioskY} x2={homeX} y2={homeY} />
          <g class="mc-ring"><ellipse class="ring a" rx="64" ry="32" /><ellipse class="ring b" rx="64" ry="32" /></g>
          <g class="mc-robot" />
          <g data-obj="robot" class="obj"><ellipse class="hit mc-robot-hit" rx="60" ry="42" /></g>
          <g class="mc-pin hide">
            <ellipse class="pin-ground" rx="20" ry="10" />
            <g class="pin-bob">
              <path class="pin-body" d="M0 -14 C-16 -30 -16 -58 0 -58 C16 -58 16 -30 0 -14 Z" />
              <circle class="pin-eye" cy="-44" r="6" />
            </g>
          </g>
          <g set:html={frontTrees.map(tree).join("")} />

          <g transform={`translate(${homeX} ${homeY - 48})`} set:html={tag("Home")} />
          <g transform={`translate(${kioskX} ${kioskY - 70})`} set:html={tag("Operator")} />
          <g class="mc-robot-tag" set:html={tag("Hunter SE", "robot")} />
        </svg>

        <div class="mc-tools glass" role="group" aria-label="Map view">
          <button type="button" data-view="in" aria-label="Zoom in"><Icon name="plus" size={17} /></button>
          <button type="button" data-view="out" aria-label="Zoom out"><Icon name="minus" size={17} /></button>
          <button type="button" data-view="fit" aria-label="Show whole field"><Icon name="fit" size={17} /></button>
          <button type="button" data-view="follow" aria-pressed="false" aria-label="Follow the robot"><Icon name="target" size={17} /></button>
        </div>
      </div>

      <ul class="mc-stats">
        <li class="mc-card glass">
          <span class="mc-ic"><Icon name="flag" size={18} /></span>
          <div><p class="mc-val"><b data-stat="wp">0</b><small>/ {waypoints.length}</small></p><p class="mc-lbl">Waypoints reached</p></div>
        </li>
        <li class="mc-card glass">
          <span class="mc-ic"><Icon name="grid" size={18} /></span>
          <div><p class="mc-val"><b data-stat="cov">0%</b></p><p class="mc-lbl">Field covered</p><span class="mc-bar"><span data-stat="covbar"></span></span></div>
        </li>
        <li class="mc-card glass">
          <span class="mc-ic"><Icon name="gauge" size={18} /></span>
          <div><p class="mc-val"><b data-stat="speed">0.00</b><small>m/s</small></p><p class="mc-lbl">Speed</p></div>
        </li>
        <li class="mc-card glass">
          <span class="mc-ic"><Icon name="route" size={18} /></span>
          <div><p class="mc-val"><b data-stat="time" class="mono">00:00</b></p><p class="mc-lbl">Mission time · <span data-stat="dist">0.0 m</span></p></div>
        </li>
      </ul>

      <aside class="mc-inspect glass" aria-live="off">
        <p class="mc-ptitle">Inspector <small>Click anything on the map</small></p>
        <div class="mc-inspect-body"></div>
      </aside>

      <section class="mc-steps glass" aria-label="Mission tracking">
        <p class="mc-ptitle">Mission tracking <small data-step-note>Command received</small></p>
        <div class="mc-steps-track">
          <div class="mc-steps-bar"><span></span></div>
          <ol>
            {steps.map((s, i) => (
              <li data-step={i}>
                <span class="mc-step-ic"><Icon name={s.icon} size={16} /></span>
                <strong>{s.label}</strong>
                <time class="mono">--:--</time>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="mc-ros glass" aria-label="ROS 2 system">
        <div class="mc-tabs" role="tablist">
          <span class="mc-ptitle"><Icon name="terminal" size={15} /> ROS 2</span>
          <button type="button" role="tab" data-tab="nodes" aria-selected="false">Nodes</button>
          <button type="button" role="tab" data-tab="topics" aria-selected="false">Topics</button>
          <button type="button" role="tab" data-tab="log" aria-selected="true">Log</button>
        </div>
        <ul class="mc-list" data-panel="nodes" hidden>
          {nodes.map((n) => <li data-node={n.drive ? "drive" : "on"}><span class="mc-dot"></span><code>{n.name}</code><small>{n.note}</small><em>active</em></li>)}
        </ul>
        <ul class="mc-list" data-panel="topics" hidden>
          {topics.map((t) => <li><code>{t.name}</code><span class="mono" data-hz={t.name} data-base={t.hz} data-always={t.always ? "" : undefined}>{t.hz}.0 Hz</span></li>)}
        </ul>
        <ol class="mc-log mono" data-panel="log"></ol>
        <p class="mc-foot">Simulated data · names and rates are illustrative</p>
      </section>
    </div>
  </section>

  <section class="section container">
    <div class="section-head reveal">
      <span class="label">The workflow</span>
      <h2>From one tap to a finished field</h2>
      <p>The tools I use at each step, from the operator's tablet down to the wheels.</p>
    </div>
    <ol class="flow">
      {flow.map((f, i) => (
        <li class="glass spot reveal">
          <span class="flow-n mono">{String(i + 1).padStart(2, "0")}</span>
          <span class="flow-ic"><Icon name={f.icon} size={24} /></span>
          <h3>{f.title}</h3>
          <p class="flow-tech mono">{f.tech}</p>
          <p>{f.text}</p>
        </li>
      ))}
    </ol>
    <p class="note reveal">
      This page is a simulation I built for the portfolio. The field, waypoint positions, timings and ROS names are
      illustrative; the workflow and the tools are the ones I use. Read more in
      <a href={url("work/robot-mission-automation/")}>one-command robot missions</a> and
      <a href={url("work/hunter-se-outdoor-navigation/")}>outdoor navigation for the Hunter SE</a>.
    </p>
  </section>
</Base>

<style>
  .page-head { padding-top: 130px; padding-bottom: 34px; }
  .page-head h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); margin: 16px 0 18px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 70ch; margin: 0; }

  .flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; list-style: none; padding: 0; margin: 0; counter-reset: flow; }
  .flow li { padding: 22px; }
  .flow li:not(:last-child)::before {
    content: ""; position: absolute; top: 46px; right: -17px; width: 18px; height: 2px; z-index: 2;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
  }
  .flow-n { position: absolute; top: 18px; right: 20px; font-size: 0.75rem; color: var(--faint); }
  .flow-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; margin-bottom: 16px; color: var(--accent); background: rgba(34, 211, 238, 0.08); border: 1px solid rgba(34, 211, 238, 0.25); }
  .flow h3 { font-size: 1.1rem; }
  .flow-tech { color: var(--accent); font-size: 0.75rem; margin: 6px 0 10px; }
  .flow p:last-child { color: var(--muted); font-size: 0.92rem; margin: 0; }
  .note { color: var(--muted); font-size: 0.9rem; margin: 26px 0 0; max-width: 80ch; }
  .note a { color: var(--accent); }
  @media (max-width: 1000px) {
    .flow { grid-template-columns: 1fr 1fr; }
    .flow li::before { display: none; }
  }
  @media (max-width: 560px) { .flow { grid-template-columns: 1fr; } }
</style>

<!-- The map and panels are partly built by src/scripts/mission.ts, so these styles are global (all under .mc). -->
<style is:global>
  .mc {
    --g-slab-t: #0b1324; --g-slab-l: #070c18; --g-slab-r: #0a1222;
    --g-field: rgba(16, 185, 129, 0.09); --g-crop: rgba(52, 211, 153, 0.28); --g-fence: rgba(148, 163, 184, 0.35);
    --g-water: rgba(34, 211, 238, 0.16); --g-leaf: #10b981; --g-leaf-hi: #34d399; --g-trunk: #64748b;
    --g-wall-l: #1e293b; --g-wall-r: #26354d; --g-roof: #334155;
    --g-body-l: #1f2937; --g-body-r: #2b3647; --g-body-t: #3b4a60;
    --g-deck-l: #cbd5e1; --g-deck-r: #e2e8f0; --g-deck-t: #f8fafc;
    --g-pending: rgba(148, 163, 184, 0.55); --g-shadow: rgba(0, 0, 0, 0.45);
    --g-tag: rgba(10, 16, 32, 0.85);
    position: relative; overflow: hidden; height: clamp(640px, 82vh, 800px); padding: 0; border-radius: 26px;
  }
  :root[data-theme="light"] .mc {
    --g-slab-t: #f3f6fc; --g-slab-l: #cfd8ea; --g-slab-r: #dfe6f3;
    --g-field: rgba(16, 185, 129, 0.12); --g-crop: rgba(5, 150, 105, 0.3); --g-fence: rgba(71, 85, 105, 0.35);
    --g-water: rgba(14, 165, 233, 0.22); --g-leaf: #34d399; --g-leaf-hi: #6ee7b7; --g-trunk: #94a3b8;
    --g-wall-l: #cbd5e1; --g-wall-r: #e2e8f0; --g-roof: #f1f5f9;
    --g-pending: rgba(71, 85, 105, 0.45); --g-shadow: rgba(30, 41, 80, 0.2);
    --g-tag: rgba(255, 255, 255, 0.92);
  }

  /* ---------- map ---------- */
  .mc-scene { position: absolute; inset: 0; }
  .mc-map { width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; user-select: none; }
  .mc-map.dragging { cursor: grabbing; }
  .mc .slab-t { fill: var(--g-slab-t); stroke: var(--glass-border); }
  .mc .slab-l { fill: var(--g-slab-l); }
  .mc .slab-r { fill: var(--g-slab-r); }
  .mc .field { fill: var(--g-field); stroke: rgba(52, 211, 153, 0.25); }
  .mc .crop { stroke: var(--g-crop); stroke-width: 2; stroke-dasharray: 2 7; stroke-linecap: round; }
  .mc .pond { fill: var(--g-water); stroke: rgba(34, 211, 238, 0.35); }
  .mc .fence { fill: none; stroke: var(--g-fence); stroke-width: 1.5; stroke-dasharray: 8 6; }
  .mc-plan { fill: none; stroke: var(--g-pending); stroke-width: 1.6; stroke-dasharray: 3 6; opacity: 0.8; }
  .mc-trail { fill: none; stroke: var(--cyan); stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.7)); }
  .mc .pad { fill: rgba(167, 139, 250, 0.14); stroke: rgba(167, 139, 250, 0.6); stroke-width: 1.5; }
  .mc .pad-in { fill: none; stroke: rgba(167, 139, 250, 0.5); stroke-dasharray: 4 4; }
  .mc .hit { fill: transparent; cursor: pointer; }
  .mc .obj.sel .pad { stroke: var(--cyan); fill: rgba(34, 211, 238, 0.18); }

  .mc .wp { cursor: pointer; }
  .mc .wp-dot { fill: var(--g-pending); transition: fill 0.3s; }
  .mc .wp-ring { fill: none; stroke: var(--g-pending); stroke-width: 1; opacity: 0.5; }
  .mc .wp.done .wp-dot { fill: var(--cyan); }
  .mc .wp.done .wp-ring { stroke: var(--cyan); opacity: 0.6; }
  .mc .wp.next .wp-ring { stroke: var(--violet); opacity: 1; stroke-width: 2; }
  .mc .wp.sel .wp-ring, .mc .wp:hover .wp-ring { stroke: var(--text); stroke-width: 2; opacity: 1; }

  .mc .tree-shadow, .mc .r-shadow { fill: var(--g-shadow); }
  .mc .trunk { stroke: var(--g-trunk); stroke-width: 4; stroke-linecap: round; }
  .mc .leaf { fill: var(--g-leaf); opacity: 0.85; }
  .mc .leaf-hi { fill: var(--g-leaf-hi); opacity: 0.7; }
  .mc .bd-l { fill: var(--g-wall-l); } .mc .bd-r { fill: var(--g-wall-r); } .mc .bd-t { fill: var(--g-roof); stroke: var(--glass-border); }
  .mc .bd-door { fill: rgba(34, 211, 238, 0.18); stroke: rgba(34, 211, 238, 0.5); }
  .mc .bd-win { fill: rgba(34, 211, 238, 0.35); }
  .mc .kp-l, .mc .kp-r, .mc .kp-t { fill: var(--g-trunk); }
  .mc .kt-l, .mc .kt-r { fill: #334155; } .mc .kt-t { fill: var(--violet); filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.8)); }
  .mc .operator rect, .mc .operator circle { fill: var(--violet); }
  .mc .operator circle { fill: #e2e8f0; }
  .mc .obj.sel .kt-t { fill: var(--cyan); }

  /* robot: dark chassis, light electronics deck, cyan headlight */
  .mc .rb-l { fill: var(--g-body-l); } .mc .rb-r { fill: var(--g-body-r); } .mc .rb-t { fill: var(--g-body-t); }
  .mc .rd-l { fill: var(--g-deck-l); } .mc .rd-r { fill: var(--g-deck-r); } .mc .rd-t { fill: var(--g-deck-t); }
  .mc .rw-l, .mc .rw-r, .mc .rw-t { fill: #0b0f19; }
  .mc .rl-l, .mc .rl-r, .mc .rl-t { fill: var(--cyan); filter: drop-shadow(0 0 4px var(--cyan)); }
  .mc .rm-l, .mc .rm-r, .mc .rm-t { fill: #475569; }
