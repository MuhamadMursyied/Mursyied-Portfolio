---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import World from "../components/World.astro";
import { person, skills, socials } from "../data/profile";
import { url } from "../utils";

const typedWords = skills.flatMap((g) => g.items).slice(0, 10).map((s) => s.name);
const headlineWords = person.headline.split(" ");
---

<!-- One screen, no scrolling: who I am on the left, my world on the right. Details live in the other tabs. -->
<Base footer={false}>
  <section class="home">
    <div class="hero-text">
      <p class="status glass reveal"><span class="dot"></span>{person.status}</p>
      <h1 class="words" aria-label={person.headline}>
        {headlineWords.map((w, i) => (<><span class="w gradient-text" style={`--i:${i}`} aria-hidden="true">{w}</span>{" "}</>))}
      </h1>
      <p class="sub reveal" style="--delay:350ms">{person.subline}</p>
      <p class="typed-line mono reveal" style="--delay:450ms">
        <span class="prompt">~/robotics $</span> working with <span class="typed" data-words={JSON.stringify(typedWords)}>{typedWords[0]}</span><span class="caret"></span>
      </p>
      <div class="actions reveal" style="--delay:550ms">
        <a class="btn primary" href={url("work/")}>View my work <Icon name="arrow" size={17} /></a>
        <a class="btn" href={url("about/")}>About me</a>
        {socials.map((s) => (
          <a class="btn icon" href={s.url} aria-label={s.label} title={s.label} target={s.url.startsWith("http") ? "_blank" : undefined} rel="noopener"><Icon name={s.icon} size={18} /></a>
        ))}
      </div>
    </div>
    <div class="home-world">
      <World />
    </div>
  </section>
</Base>

<style>
  .home {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); gap: 40px; align-items: center;
    height: 100vh; height: 100svh; max-width: 1560px; margin: 0 auto; padding: 84px 28px 28px; overflow: hidden;
  }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 7px 15px; border-radius: 999px; font-size: 0.82rem; color: var(--muted); margin-bottom: 22px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 12px #34d399; }
  h1 { font-size: clamp(2.3rem, 4.4vw, 4rem); line-height: 1.02; letter-spacing: -0.04em; margin-bottom: 20px; }
  .sub { font-size: clamp(0.98rem, 1.3vw, 1.12rem); color: var(--muted); max-width: 52ch; }
  .typed-line { font-size: 0.9rem; color: var(--muted); margin: 4px 0 26px; }
  .prompt { color: var(--violet); }
  .typed { color: var(--text); font-weight: 500; }
  .caret { display: inline-block; width: 0.55em; height: 1.1em; vertical-align: -0.2em; margin-left: 3px; background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn.icon { width: 46px; padding: 0; justify-content: center; }
  /* the map keeps its shape and shrinks to fit the screen height */
  .home-world { height: 100%; min-height: 0; display: flex; align-items: center; }
  .home-world :global(.world) { width: 100%; height: auto; max-height: 100%; }
  .home-world :global(.world-map) { aspect-ratio: 1240 / 760; max-height: calc(100svh - 112px); margin: 0 auto; }

  /* tablets and phones: text on top, the map takes the rest of the screen */
  @media (max-width: 900px) {
    .home { display: flex; flex-direction: column; align-items: stretch; gap: 14px; padding: 72px 16px 16px; }
    .status { margin-bottom: 14px; font-size: 0.76rem; padding: 6px 12px; }
    h1 { font-size: clamp(1.9rem, 7.4vw, 2.6rem); margin-bottom: 10px; }
    .sub { font-size: 0.92rem; margin-bottom: 0.6em; }
    .typed-line { display: none; }
    .actions .btn { min-height: 42px; }
    .home-world { flex: 1; }
    .home-world :global(.world) { height: 100%; }
    .home-world :global(.world-map) { aspect-ratio: auto; height: 100%; max-height: none; }
  }
  @media (max-width: 480px) {
    .btn.icon { display: none; }
  }
  @media (max-width: 640px) {
    .home { padding-bottom: 92px; }
  }
  @media (max-height: 700px) and (min-width: 901px) {
    .typed-line { display: none; }
    .sub { display: none; }
  }
</style>
