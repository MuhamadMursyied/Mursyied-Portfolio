---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { projectMeta, url } from "../utils";

interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { title, summary, tags, images } = project.data;
const cover = images[0];
---

<li class="card-wrap reveal" data-tags={tags.join("|")}>
  <a class="card glass spot tilt" href={url(`work/${project.id}/`)}>
    <div class="cover">
      {cover && <img src={url(cover)} alt="" loading={index < 2 ? "eager" : "lazy"} decoding="async" transition:name={`cover-${project.id}`} />}
      <span class="count mono">{String(index + 1).padStart(2, "0")}</span>
      {images.length > 1 && <span class="pics mono">{images.length} images</span>}
    </div>
    <div class="body">
      <p class="date mono">{projectMeta(project.data)}</p>
      <h3>{title}</h3>
      <p class="summary">{summary}</p>
      <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
      <span class="more">Open project <Icon name="arrow" size={16} /></span>
    </div>
  </a>
</li>

<style>
  .card-wrap { list-style: none; }
  .card-wrap.pop { animation: pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes pop { from { opacity: 0; transform: scale(0.96); } }
  .card {
    display: flex; flex-direction: column; height: 100%; overflow: hidden; text-decoration: none;
    transition: transform 0.25s ease-out, border-color 0.2s, box-shadow 0.2s; will-change: transform;
  }
  .card:hover { box-shadow: var(--shadow), var(--glow); }
  .cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--glass-border); background: rgba(0, 0, 0, 0.25); }
  .cover img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .card:hover .cover img { transform: scale(1.05); }
  .cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(4, 6, 13, 0.55)); pointer-events: none; }
  .count, .pics {
    position: absolute; z-index: 1; padding: 5px 9px; border-radius: 999px; font-size: 0.7rem; letter-spacing: 0.08em;
    background: rgba(4, 6, 13, 0.6); color: #cfe9ff; border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px);
  }
  .count { top: 12px; left: 12px; }
  .pics { bottom: 12px; right: 12px; }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 20px 22px 22px; flex: 1; }
  .date { margin: 0; font-size: 0.75rem; color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase; }
  h3 { font-size: 1.25rem; }
  .summary { color: var(--muted); margin: 0; font-size: 0.95rem; }
  .tags { margin-top: 4px; }
  .more { margin-top: auto; padding-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--accent); }
  .more :global(svg) { transition: transform 0.2s; }
  .card:hover .more :global(svg) { transform: translateX(4px); }
</style>
